{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "leblanc-site",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 4321
    },
    {
      "name": "crm-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["backend/server.js"],
      "env": { "PORT": "3001", "CRM_PASSWORD": "local-dev-pw", "DEV_WEBSITE_ORIGIN": "http://localhost:4321" },
      "port": 3001
    },
    {
      "name": "crm-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    }
  ]
}
